{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Monkey C: Build and Run BodyMetrics (fr265)",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/run-bodymetrics-sim.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Monkey C: Build and Run BodyMetrics (device picker)",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/run-sim.sh",
        "${input:targetDevice}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Monkey C: Build All Devices",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/build-all-devices.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "targetDevice",
      "type": "pickString",
      "description": "Target device for the simulator",
      "options": [
        "fr165", "fr165m", "fr255m", "fr255sm", "fr265", "fr265s",
        "fr955", "fr965", "fr970",
        "fr57042mm", "fr57047mm",
        "fenix7", "fenix7s", "fenix7x", "fenix7pro", "fenix7spro",
        "fenix7xpro", "fenix7pronowifi", "fenix7xpronowifi",
        "fenix843mm", "fenix847mm", "fenix8pro47mm",
        "fenix8solar47mm", "fenix8solar51mm", "fenixe",
        "epix2", "epix2pro42mm", "epix2pro47mm", "epix2pro51mm",
        "venu2", "venu2s", "venu2plus", "venu3", "venu3s", "venu441mm", "venu445mm",
        "vivoactive5", "vivoactive6",
        "marq2", "marq2aviator",
        "enduro3",
        "d2airx10", "d2mach1", "d2mach2", "d2mach2pro",
        "instinct3amoled45mm", "instinct3amoled50mm", "instinctcrossoveramoled",
        "descentg2", "descentmk343mm", "descentmk351mm",
        "approachs7042mm", "approachs7047mm"
      ],
      "default": "fr265"
    }
  ]
}
